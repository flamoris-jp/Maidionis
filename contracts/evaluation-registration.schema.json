{
  "$id": "maidionis.evaluation-registration.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baselines": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "config_digest": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "type": "string"
          },
          "version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "config_digest"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array",
      "uniqueItems": false
    },
    "calibration": {
      "enum": [
        "required",
        "not_applicable"
      ]
    },
    "dataset_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "descriptor_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "environment_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evaluated_component_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "experiment_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "metrics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "config_digest": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "type": "string"
          },
          "version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "config_digest"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": false
    },
    "minimum_samples": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    },
    "policy_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "maidionis.evaluation-registration.v1"
    },
    "selection_scope": {
      "enum": [
        "dev",
        "train_diagnostic"
      ]
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "calibration_fit",
        "calibration_select",
        "test"
      ]
    },
    "tolerance": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "experiment_id",
    "policy_digest",
    "descriptor_digest",
    "evaluated_component_digest",
    "dataset_digest",
    "split",
    "selection_scope",
    "metrics",
    "baselines",
    "calibration",
    "minimum_samples",
    "tolerance",
    "environment_digest"
  ],
  "type": "object"
}
