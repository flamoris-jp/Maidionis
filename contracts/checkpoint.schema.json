{
  "$id": "maidionis.checkpoint.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkpoint_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "codec_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "config_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "created_at": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "dataset_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "descriptor_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "environment_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "maximum": 1073741824,
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$",
            "type": "string"
          },
          "sha256": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 0,
      "type": "array",
      "uniqueItems": false
    },
    "history_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "maidionis.checkpoint.v1"
    },
    "state_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "checkpoint_id",
    "created_at",
    "descriptor_digest",
    "config_digest",
    "dataset_digest",
    "environment_digest",
    "codec_digest",
    "files",
    "state_digest",
    "history_digest"
  ],
  "type": "object"
}
