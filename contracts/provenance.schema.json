{
  "$id": "maidionis.provenance.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ancestry": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]{1,128}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "created_at": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "accepted",
        "rejected",
        "corrected"
      ]
    },
    "final_target": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "config_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "config_digest"
      ],
      "type": "object"
    },
    "human_audit_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      ]
    },
    "non_model_source_reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "outcome": {
      "enum": [
        "verified",
        "rejected",
        "unverified"
      ]
    },
    "prompt_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      ]
    },
    "proposed_target": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "raw_response_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      ]
    },
    "reviewed_target": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "config_digest": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            },
            "version": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "version",
            "config_digest"
          ],
          "type": "object"
        }
      ]
    },
    "sample_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "sampling_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      ]
    },
    "schema_version": {
      "const": "maidionis.provenance.v1"
    },
    "source_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_license": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        }
      ]
    },
    "teacher": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "config_digest": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            },
            "version": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "version",
            "config_digest"
          ],
          "type": "object"
        }
      ]
    },
    "verification_profile": {
      "additionalProperties": false,
      "properties": {
        "config_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "config_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "provenance_id",
    "sample_id",
    "ancestry",
    "source_digest",
    "source_license",
    "generator",
    "teacher",
    "reviewer",
    "non_model_source_reason",
    "prompt_digest",
    "sampling_digest",
    "raw_response_digest",
    "proposed_target",
    "reviewed_target",
    "final_target",
    "verification_profile",
    "outcome",
    "disposition",
    "human_audit_ref",
    "created_at",
    "supersedes"
  ],
  "type": "object"
}
