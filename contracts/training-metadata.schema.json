{
  "$id": "maidionis.training-metadata.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "checkpoint_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "betas": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": false
        },
        "device": {
          "enum": [
            "cpu"
          ]
        },
        "dtype": {
          "enum": [
            "float32"
          ]
        },
        "epoch_order": {
          "enum": [
            "sha256_sort.v1"
          ]
        },
        "epochs": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "epsilon": {
          "maximum": 1,
          "minimum": 1e-12,
          "type": "number"
        },
        "learning_rate": {
          "maximum": 1,
          "minimum": 1e-12,
          "type": "number"
        },
        "max_grad_norm": {
          "maximum": 1000,
          "minimum": 1e-12,
          "type": "number"
        },
        "optimizer": {
          "enum": [
            "adamw.v1"
          ]
        },
        "patience": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "scheduler": {
          "enum": [
            "linear_decay.v1"
          ]
        },
        "seed": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "selection_scope": {
          "enum": [
            "dev",
            "train_diagnostic"
          ]
        },
        "threads": {
          "const": 1
        },
        "weight_decay": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "seed",
        "epochs",
        "batch_size",
        "patience",
        "learning_rate",
        "weight_decay",
        "max_grad_norm",
        "selection_scope",
        "scheduler",
        "optimizer",
        "betas",
        "epsilon",
        "epoch_order",
        "device",
        "dtype",
        "threads"
      ],
      "type": "object"
    },
    "dataset_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "descriptor_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "environment_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "model_config": {
      "additionalProperties": false,
      "properties": {
        "controls": {
          "items": {
            "maximum": 8191,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "dropout_milli": {
          "maximum": 999,
          "minimum": 0,
          "type": "integer"
        },
        "ffn_width": {
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "heads": {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "hidden_width": {
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "input_width": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "dense",
            "pooled",
            "encoder"
          ]
        },
        "layers": {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "max_length": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "output_width": {
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "vocabulary": {
          "maximum": 8192,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "input_width",
        "hidden_width",
        "output_width",
        "dropout_milli",
        "vocabulary",
        "layers",
        "heads",
        "ffn_width",
        "max_length",
        "controls"
      ],
      "type": "object"
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "best_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "best_objective": {
          "maximum": 1e+30,
          "minimum": 0,
          "type": "number"
        },
        "best_weights_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "completed_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "epoch_order_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        },
        "global_step": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "history": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "epoch": {
                "maximum": 9223372036854775807,
                "minimum": 0,
                "type": "integer"
              },
              "improved": {
                "type": "boolean"
              },
              "loss": {
                "maximum": 1e+30,
                "minimum": 0,
                "type": "number"
              },
              "lr": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "objective": {
                "maximum": 1e+30,
                "minimum": 0,
                "type": "number"
              },
              "step": {
                "maximum": 9223372036854775807,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "epoch",
              "step",
              "loss",
              "objective",
              "lr",
              "improved"
            ],
            "type": "object"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": false
        },
        "next_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "parameter_groups": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "decay": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "name": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "decay"
            ],
            "type": "object"
          },
          "maxItems": 100000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": false
        },
        "patience_counter": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "planned_total_steps": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "rng_inventory": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array",
          "uniqueItems": false
        },
        "scheduler": {
          "additionalProperties": false,
          "properties": {
            "base_lr": {
              "maximum": 1,
              "minimum": 1e-12,
              "type": "number"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            },
            "phase": {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            "version": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "version",
            "phase",
            "base_lr"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": "maidionis.training-state.v1"
        },
        "selection_scope": {
          "enum": [
            "dev",
            "train_diagnostic"
          ]
        },
        "stopped": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "completed_epoch",
        "next_epoch",
        "global_step",
        "planned_total_steps",
        "scheduler",
        "parameter_groups",
        "best_objective",
        "best_epoch",
        "best_weights_digest",
        "patience_counter",
        "stopped",
        "selection_scope",
        "epoch_order_version",
        "rng_inventory",
        "history"
      ],
      "type": "object"
    },
    "training_run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "weights_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "training_run_id",
    "config",
    "state",
    "checkpoint_digest",
    "dataset_digest",
    "environment_digest",
    "descriptor_digest",
    "build_digest",
    "model_config",
    "weights_digest"
  ],
  "type": "object"
}
