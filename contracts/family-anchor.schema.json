{
  "$id": "maidionis.family-anchor.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grouping_profile": {
      "additionalProperties": false,
      "properties": {
        "config_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "config_digest"
      ],
      "type": "object"
    },
    "root_digests": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "maidionis.family-anchor.v1"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "task_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "task_version",
    "grouping_profile",
    "root_digests"
  ],
  "type": "object"
}
