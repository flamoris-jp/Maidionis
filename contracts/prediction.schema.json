{
  "$id": "maidionis.prediction.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "calibration_status": {
      "enum": [
        "calibrated",
        "uncalibrated",
        "not_applicable"
      ]
    },
    "dataset_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "descriptor_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "error_status": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        }
      ]
    },
    "evaluated_component_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evaluation_registration_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "experiment_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "raw_output": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_output_schema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          ]
        },
        "context_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "digest": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "projection_version": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                  "type": "string"
                },
                "snapshot_id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                  "type": "string"
                },
                "source_id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "snapshot_id",
                "projection_version",
                "digest"
              ],
              "type": "object"
            }
          ]
        },
        "diagnostics": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "invalid_request",
                    "unsupported_schema",
                    "unsupported_specialization",
                    "incompatible_contract",
                    "input_too_large",
                    "artifact_invalid",
                    "profile_unsupported",
                    "resource_exhausted",
                    "nonfinite_output",
                    "cancelled",
                    "deadline_exceeded",
                    "internal_error"
                  ]
                },
                "message": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            }
          ]
        },
        "payload": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload_schema": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                  "type": "string"
                },
                "sha256": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "version": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:-]{1,128}$",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "type": "object"
            }
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          ]
        },
        "schema_version": {
          "const": "maidionis.result.v1"
        },
        "specialization_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          ]
        },
        "specialization_version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          ]
        },
        "status": {
          "enum": [
            "ok",
            "abstain",
            "error"
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          ]
        },
        "task_version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "specialization_id",
        "specialization_version",
        "task_id",
        "task_version",
        "artifact_digest",
        "context_ref",
        "payload_schema",
        "status",
        "payload",
        "diagnostics",
        "error"
      ],
      "type": "object"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "sample_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
    },
    "schema_version": {
      "const": "maidionis.prediction.v1"
    },
    "selection_scope": {
      "enum": [
        "dev",
        "train_diagnostic"
      ]
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "calibration_fit",
        "calibration_select",
        "test"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "timing": {
      "additionalProperties": false,
      "properties": {
        "elapsed_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "profile": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "elapsed_ns",
        "profile"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "run_id",
    "sample_id",
    "dataset_id",
    "dataset_digest",
    "split",
    "descriptor_digest",
    "artifact_digest",
    "evaluated_component_digest",
    "evaluation_registration_digest",
    "selection_scope",
    "calibration_status",
    "result",
    "target",
    "raw_output_schema",
    "raw_output",
    "timing",
    "error_status"
  ],
  "type": "object"
}
